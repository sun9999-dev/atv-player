+    def _looks_like_subtitle_text(text: str) -> bool:
+        """正文是否像字幕：拒绝 JSON 错误体 / HTML 页（alist 对无签名字幕回 HTTP 200 + {"code":401,...}，
+        只看状态码会被骗）。合法字幕开头不可能是 JSON 错误体或 HTML：SRT 以数字开头，ASS/SSA 以 [Script Info] 开头，
