+        stripped = text.lstrip("\ufeff \t\r\n")
+        if not stripped:
+            return False
+        lowered = stripped.lower()
+        if lowered.startswith("<!doctype") or lowered.startswith("<html"):
+            return False
+        if stripped.startswith("{"):
+            try:
+                obj = json.loads(stripped[:2048])
+            except Exception:
                 return True
-        except Exception:
-            pass
+            if isinstance(obj, dict) and ("code" in obj or "message" in obj):
+                return False
+        return True
