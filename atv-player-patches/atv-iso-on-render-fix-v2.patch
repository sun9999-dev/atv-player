+    def set_iso_track_languages(self, languages: tuple[tuple[str, str], ...] | list[tuple[str, str]] | None) -> None:
+        """设置 ISO（.clpi）流语言；非 ISO 传 () 清空。仅存元组，无 Qt 调用。"""
+        self._iso_track_languages = tuple(languages or ())
+
+    def _iso_language_for_track(self, kind: str, index: int) -> str:
+        """取 .clpi 里第 index 条该类型流的语言（同类型顺序）；没有返回 ""。"""
+        langs = [lang for item_kind, lang in self._iso_track_languages if item_kind == kind]
+        if 0 <= index < len(langs):
+            return langs[index]
+        return ""
