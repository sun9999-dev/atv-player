+def _parse_clpi_program_languages(data: bytes) -> tuple[tuple[str, str], ...]:
+    """解析 .clpi ProgramInfo，返回 (kind, lang) 列表（ProgramInfo 顺序）。
+
+    按 libbluray clpi_parse.c（_parse_program / _parse_stream_attr）：
+    流条目 = pid(2) + len(1) + coding_type(1) + 字段 + isrc(12) + 填充，
+    len = 从 coding_type 到条目尾的字节数（含 isrc 与填充）。
+    语言码（3 字母 ISO 639-2/T）位置：
+      音频(0x03/0x04/0x80-0x86/0xa1/0xa2)：条目+5（coding_type 后 1 字节 format+rate）
+      PGS(0x90)：条目+4（coding_type 后直接是语言）
+      Text(0x92)：条目+5（coding_type 后 1 字节 char_code）
+    视频无语言。解析失败返回 ()（调用方按无语言处理，不报错）。
+    """
+    try:
+        if len(data) < 32 or data[:4] != b"HDMV":
+            return ()
+        program_info_start = _read_u32be(data, 12)
+        if program_info_start <= 0 or program_info_start + 6 > len(data):
+            return ()
+        program_count = data[program_info_start + 5]
+        cursor = program_info_start + 6
+        result: list[tuple[str, str]] = []
+        for _ in range(program_count):
+            if cursor + 8 > len(data):
+                break
+            # spn_program_sequence_start(4) + program_map_pid(2) + stream_count(1) + num_groups(1)
+            stream_count = data[cursor + 6]
+            cursor += 8
+            for _ in range(stream_count):
+                if cursor + 3 > len(data):
+                    break
+                attr_len = data[cursor + 2]  # len：1 字节
+                coding_type = data[cursor + 3]
+                if attr_len < 1 or cursor + 3 + attr_len > len(data):
+                    break
+                kind = _clpi_coding_type_kind(coding_type)
+                if kind is not None:
+                    # PGS(0x90) 语言在条目+4；音频/Text 在条目+5
+                    lang_off = cursor + 4 if coding_type == 0x90 else cursor + 5
+                    try:
+                        lang = data[lang_off : lang_off + 3].decode("ascii").strip().lower()
+                    except UnicodeDecodeError:
+                        lang = ""
+                    if len(lang) == 3 and lang.isalpha():
+                        result.append((kind, lang))
+                cursor += 3 + attr_len
+        return tuple(result)
+    except Exception:
+        return ()
+
