+def _clpi_coding_type_kind(coding_type: int) -> str | None:
+    """_clpi ProgramInfo coding_type -> "audio" / "subtitle" / None（video/菜单等无语言）。"""
+    if coding_type in (
+        0x03, 0x04,  # MPEG-1/2 Audio
+        0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87,  # LPCM/AC-3/DTS/TrueHD/...
+        0xA1, 0xA2,  # E-AC-3 secondary / DTS Express
+    ):
+        return "audio"
+    if coding_type in (0x90, 0x92):  # PGS / Text subtitle
+        return "subtitle"
+    return None
+
