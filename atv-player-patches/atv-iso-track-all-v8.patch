+def _parse_mpls_stream_entry(data: bytes, offset: int) -> tuple[int, str, int]:
+    """解析 .mpls STN 表里一条流，返回 (coding_type, lang, 下一条 offset)。
+
+    每条流 = len1(1) + [stream_type + pid…](len1) + len2(1) + [coding_type + 字段…](len2)。
+    语言：audio 在 coding_type 后 2 字节（format/rate 1 字节后）；PGS(0x90) 在后 1 字节；
+    Text(0x92) 在后 2 字节（char_code 1 字节后）。解析失败返回 (0, "", len(data))。
+    """
+    try:
+        if offset < 0 or offset + 2 > len(data):
+            return (0, "", len(data))
+        len1 = data[offset]
+        pos1 = offset + 1
+        next1 = pos1 + len1
+        if next1 + 2 > len(data):
+            return (0, "", len(data))
+        len2 = data[next1]
+        pos2 = next1 + 1
+        coding_type = data[pos2]
+        lang = ""
+        if coding_type in (
+            0x03, 0x04, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0xA1, 0xA2,
+        ):
+            if pos2 + 5 <= len(data):
+                lang = data[pos2 + 2 : pos2 + 5].decode("ascii", errors="ignore").strip().lower()
+        elif coding_type == 0x90:
+            if pos2 + 4 <= len(data):
+                lang = data[pos2 + 1 : pos2 + 4].decode("ascii", errors="ignore").strip().lower()
+        elif coding_type == 0x92:
+            if pos2 + 5 <= len(data):
+                lang = data[pos2 + 2 : pos2 + 5].decode("ascii", errors="ignore").strip().lower()
+        if len(lang) != 3 or not lang.isalpha():
+            lang = ""
+        next_offset = pos2 + len2
+        if next_offset <= offset:
+            next_offset = len(data)
+        return (coding_type, lang, next_offset)
+    except Exception:
+        return (0, "", len(data))
+
+
+def _parse_mpls_stn_languages(data: bytes, stn_start: int) -> tuple[tuple[str, str], ...]:
+    """解析 .mpls STN 表，返回 (kind, lang) 列表（STN 顺序：audio 在前，PG 在后）。
+
+    STN 表 = len(2) + reserved(2) + 8 个计数(8) + reserved(4) + 流条目
+    （video, audio, PG, IG, secondary_audio, secondary_video, pip_pg, dv 顺序）。
+    IG(0x91) 是菜单图形，不算字幕。解析失败返回 ()。
+    """
+    try:
+        if stn_start < 0 or stn_start + 16 > len(data):
+            return ()
+        counts = data[stn_start + 4 : stn_start + 12]
+        if len(counts) < 8:
+            return ()
+        num_video, num_audio, num_pg, num_ig, num_sec_audio, num_sec_video, num_pip_pg, num_dv = counts
+        offset = stn_start + 16
+        result: list[tuple[str, str]] = []
+        # 按 STN 顺序跳过各段：video(无语言) -> audio -> PG -> IG(跳过) -> 其余(跳过)。
+        for _ in range(num_video):
+            _, _, offset = _parse_mpls_stream_entry(data, offset)
+        for _ in range(num_audio):
+            coding_type, lang, offset = _parse_mpls_stream_entry(data, offset)
+            if lang:
+                kind = _clpi_coding_type_kind(coding_type)
+                if kind == "audio":
+                    result.append(("audio", lang))
+        for _ in range(num_pg):
+            coding_type, lang, offset = _parse_mpls_stream_entry(data, offset)
+            if lang and coding_type in (0x90, 0x92):
+                result.append(("subtitle", lang))
+        for _ in range(num_ig + num_sec_audio + num_sec_video + num_pip_pg + num_dv):
+            _, _, offset = _parse_mpls_stream_entry(data, offset)
+        return tuple(result)
+    except Exception:
+        return ()
+
+
